# TypeSafe Jev (typed decisions): https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# Ollama cloud API key (Gemma 4 31B): https://ollama.com/settings/keys
OLLAMA_KEY=
LLM_MODEL=gemma4:31b
LLM_FALLBACK_MODEL=gpt-oss:20b
# Free Gemini API key (AI Studio, from a project WITHOUT billing) used as the last LLM fallback
GEMINI_API_KEY=
GEMINI_FALLBACK_MODEL=gemini-flash-latest
# Firestore project (uses Application Default Credentials locally)
GOOGLE_CLOUD_PROJECT=
# Optional: shared secret between MCP server and tools API
TOOLS_API_KEY=
# Required to call POST /api/improve (header X-Admin-Token)
ADMIN_TOKEN=
